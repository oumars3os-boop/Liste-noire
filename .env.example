# Configuration du serveur
PORT=3000
NODE_ENV=development

# Clé de chiffrement (32 caractères hexadécimaux pour AES-256)
# Générez avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=votre-clé-32-caractères-hex

# Clé secrète alternative (sera hashée avec scrypt)
SECRET=votre-clé-secrète-très-longue-et-sécurisée

# Chemin de la base de données
DB_PATH=./data/otp.db
